#!/bin/bash
# Equifinality (in-zone release window, landing SD over +/-40 ms) of every
# checkpoint of every run matching PREFIX: scripts/equifinality.py
#   qsub -v PREFIX=throw_ppo_run15,ZONE="10.9 12.9" hpc/equifinality.pbs
# Writes logs/<run>/equifinality.csv per run.
#PBS -N cricket_equifinal
#PBS -q cpuq
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR"
module load python/3.14.0-gcc-12.5.0-4km4ttx
source .venv/bin/activate
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
: "${PREFIX:?pass a run prefix}"
ZONE="${ZONE:-6.0 8.0}"
git -C "$PBS_O_WORKDIR" rev-parse --short HEAD

ls -d logs/${PREFIX}_* | xargs -n1 basename | xargs -P 8 -I{} sh -c \
    "python scripts/equifinality.py --run {} --target-range ${ZONE} > logs/{}/equifinality.log 2>&1; echo \"{} exit \$?\""
echo "=== done ==="
