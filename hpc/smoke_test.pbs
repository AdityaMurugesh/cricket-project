#!/bin/bash
# PBS job script -- validates the submission pipeline (module load, venv,
# job scheduling) on cpuq, independent of the RL training code.
# Submit from the project root: qsub hpc/smoke_test.pbs
#PBS -N cricket_smoke_test
#PBS -q cpuq
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=00:10:00
#PBS -j oe

cd "$PBS_O_WORKDIR"
module load python/3.14.0-gcc-12.5.0-4km4ttx
source .venv/bin/activate
python scripts/smoke_test.py
