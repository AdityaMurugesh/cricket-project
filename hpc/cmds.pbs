#!/bin/bash
# Run the lines of CMDS (one shell command each), P at a time (light scoring jobs).
#   qsub -v CMDS=hpc/packs/score_goal.txt,P=8 hpc/cmds.pbs
#PBS -N cricket_cmds
#PBS -q cpuq
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe

cd "$PBS_O_WORKDIR"
module load python/3.14.0-gcc-12.5.0-4km4ttx
source .venv/bin/activate
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
: "${CMDS:?pass CMDS=<file>}"
grep -v '^\s*\(#\|$\)' "${CMDS}" | xargs -P "${P:-8}" -I{} bash -c '{}' 2>&1 | grep -v Warning
echo "cmds exit $?"
