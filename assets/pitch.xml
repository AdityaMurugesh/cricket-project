<!-- Full-size cricket pitch, VISUAL ONLY (contype/conaffinity 0 everywhere):
     it changes nothing ThrowEnv simulates or rewards, so run10 replays and
     training are unaffected. The ball can pass through the stumps.

     Laws of Cricket dimensions, x along the pitch, release over the bowler's
     popping crease at x = 0:
       stumps to stumps 20.12 m, popping crease 1.22 m in front of the stumps
         -> bowler's stumps x = -1.22, batter's popping crease x = 17.68,
            batter's stumps x = 18.90
       pitch 3.05 m wide; bowling crease 2.64 m long
       wicket 22.86 cm wide, stumps 71.1 cm tall
     The training target (target_zone, 6-8 m, in throw_arm.xml) is unchanged.
     good_length marks 6-8 m in front of the batter's stumps, where a real
     good-length ball pitches; no policy is trained for it yet. -->
<mujoco>
  <!-- the arm's two lights only reach a few metres; light the whole ground -->
  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.45 0.45 0.45"/>
  </visual>
  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.72 0.9" rgb2="0.9 0.94 1"
             width="256" height="256"/>
  </asset>

  <default>
    <default class="pitch">
      <geom contype="0" conaffinity="0" group="1"/>
      <default class="crease">
        <geom type="box" rgba="0.97 0.97 0.97 1"/>
      </default>
      <default class="stump">
        <geom type="cylinder" size="0.019 0.3555" rgba="0.93 0.86 0.7 1"/>
      </default>
      <default class="bail">
        <geom type="capsule" size="0.008 0.045" euler="90 0 0" rgba="0.93 0.86 0.7 1"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light name="sun" directional="true" pos="9 -6 12" dir="-0.2 0.4 -1" diffuse="0.5 0.5 0.5"
           castshadow="false"/>
    <geom name="pitch_strip" class="pitch" type="box" pos="8.84 0 0.001" size="10.06 1.525 0.001"
          rgba="0.78 0.7 0.5 1"/>
    <geom name="good_length" class="pitch" type="box" pos="11.9 0 0.0015" size="1.0 1.525 0.0015"
          rgba="0.95 0.8 0.2 0.35"/>

    <!-- bowler's end -->
    <geom class="crease" pos="-1.22 0 0.003" size="0.025 1.32 0.001"/>
    <geom class="crease" pos="0 0 0.003" size="0.025 1.83 0.001"/>
    <geom class="crease" pos="-0.61 1.32 0.003" size="0.61 0.025 0.001"/>
    <geom class="crease" pos="-0.61 -1.32 0.003" size="0.61 0.025 0.001"/>
    <geom class="stump" pos="-1.22 -0.095 0.3555"/>
    <geom class="stump" pos="-1.22 0 0.3555"/>
    <geom class="stump" pos="-1.22 0.095 0.3555"/>
    <geom class="bail" pos="-1.22 -0.048 0.72"/>
    <geom class="bail" pos="-1.22 0.048 0.72"/>

    <!-- batter's end -->
    <geom class="crease" pos="18.9 0 0.003" size="0.025 1.32 0.001"/>
    <geom class="crease" pos="17.68 0 0.003" size="0.025 1.83 0.001"/>
    <geom class="crease" pos="18.29 1.32 0.003" size="0.61 0.025 0.001"/>
    <geom class="crease" pos="18.29 -1.32 0.003" size="0.61 0.025 0.001"/>
    <geom class="stump" pos="18.9 -0.095 0.3555"/>
    <geom class="stump" pos="18.9 0 0.3555"/>
    <geom class="stump" pos="18.9 0.095 0.3555"/>
    <geom class="bail" pos="18.9 -0.048 0.72"/>
    <geom class="bail" pos="18.9 0.048 0.72"/>
  </worldbody>
</mujoco>
