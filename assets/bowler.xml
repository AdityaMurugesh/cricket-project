<mujoco model="bowler">
  <compiler angle="degree"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom contype="1" conaffinity="1" friction="0.9 0.005 0.0001"/>
  </default>

  <worldbody>
    <light diffuse="0.6 0.6 0.6" pos="0 0 4" dir="0 0 -1"/>
    <light diffuse="0.3 0.3 0.3" pos="3 -3 3" dir="-1 1 -1"/>

    <geom name="ground" type="plane" size="20 5 0.1" rgba="0.3 0.5 0.3 1"/>
    <geom name="target_zone" type="box" pos="7.0 0 0.002" size="1.0 0.6 0.002"
          rgba="0.9 0.2 0.2 0.4" contype="0" conaffinity="0"/>

    <!-- root/leg default pos and joint "ref" values are cosmetic only --
         BowlerEnv drives qpos directly every frame (see envs/runup.py),
         never relies on these compiled defaults. -->
    <body name="root" pos="0 0 0.80">
      <freejoint name="root_free"/>
      <geom name="pelvis" type="box" size="0.12 0.1 0.08" rgba="0.4 0.4 0.6 1"/>

      <body name="torso" pos="0 0 0.25">
        <geom name="torso_geom" type="box" size="0.14 0.11 0.22" rgba="0.45 0.45 0.7 1"/>

        <body name="head" pos="0 0 0.32">
          <geom type="sphere" size="0.1" rgba="0.8 0.7 0.6 1" contype="0" conaffinity="0"/>
        </body>

        <!-- bowling arm, reused as-is from throw_arm.xml -->
        <body name="shoulder_mount" pos="0 -0.2 0.15">
          <geom type="sphere" size="0.05" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
          <body name="upper_arm" pos="0 0 0">
            <!-- upper bound raised from 380 to 450 so the scripted delivery's
                 follow-through (FOLLOW_THROUGH_ARM_DEG, 430 deg) fits inside
                 the joint's range rather than sitting past its limit. -->
            <joint name="shoulder" type="hinge" axis="0 1 0" range="60 450"/>
            <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.04" rgba="0.6 0.6 0.9 1"/>
            <body name="forearm" pos="0.35 0 0">
              <joint name="elbow" type="hinge" axis="0 1 0" range="0 160"/>
              <geom type="capsule" fromto="0 0 0 0.3 0 0" size="0.035" rgba="0.5 0.5 0.8 1"/>
              <site name="hand" pos="0.3 0 0" size="0.02"/>
            </body>
          </body>
        </body>

        <!-- non-bowling arm: fixed, cosmetic only -->
        <body name="other_arm" pos="0 0.2 0.1">
          <geom type="capsule" fromto="0 0 0 0.05 0.05 -0.4" size="0.04" rgba="0.6 0.6 0.9 1"
                contype="0" conaffinity="0"/>
        </body>
      </body>

      <!-- left leg -->
      <body name="left_thigh" pos="0 0.09 0">
        <joint name="left_hip" type="hinge" axis="0 1 0" range="-60 90" ref="25"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.05" rgba="0.5 0.5 0.5 1"/>
        <body name="left_shin" pos="0 0 -0.4">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="-140 0" ref="-10"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.045" rgba="0.5 0.5 0.5 1"/>
          <body name="left_foot" pos="0 0 -0.4">
            <joint name="left_ankle" type="hinge" axis="0 1 0" range="-40 40" ref="0"/>
            <geom name="left_foot_geom" type="box" size="0.11 0.045 0.02" pos="0.06 0 -0.02"
                  rgba="0.2 0.2 0.2 1"/>
          </body>
        </body>
      </body>

      <!-- right leg -->
      <body name="right_thigh" pos="0 -0.09 0">
        <joint name="right_hip" type="hinge" axis="0 1 0" range="-60 90" ref="-25"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.05" rgba="0.5 0.5 0.5 1"/>
        <body name="right_shin" pos="0 0 -0.4">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="-140 0" ref="-25"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.4" size="0.045" rgba="0.5 0.5 0.5 1"/>
          <body name="right_foot" pos="0 0 -0.4">
            <joint name="right_ankle" type="hinge" axis="0 1 0" range="-40 40" ref="10"/>
            <geom name="right_foot_geom" type="box" size="0.11 0.045 0.02" pos="0.06 0 -0.02"
                  rgba="0.2 0.2 0.2 1"/>
          </body>
        </body>
      </body>
    </body>

    <body name="ball" pos="0 0 2">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.036" mass="0.16" rgba="0.9 0.9 0.9 1"/>
    </body>
  </worldbody>

  <contact>
    <!-- The ball sphere (r=0.036) sits exactly on the hand site, which is
         the endpoint of the forearm capsule (r=0.035), so the two geoms
         start 0.071 m interpenetrated and stay that way for the whole
         carry. The weld holds them together while the contact solver
         shoves them apart, and the accumulated contact force is released
         in one kick the instant the weld deactivates. That is why throws
         drifted up to 1.5 m off-line in a mechanism that is purely planar
         (the shoulder and elbow are both hinges about Y, so a correct
         release has exactly zero lateral velocity). It also injects energy
         into the release speed, which is the reported research metric.
         Excluding the pair leaves the weld as the only thing coupling the
         ball to the hand, which is what "ball welded to the end effector"
         was supposed to mean. -->
    <exclude body1="ball" body2="forearm"/>
  </contact>
  <equality>
    <weld name="grip" body1="ball" body2="forearm" solref="0.002 1" solimp="0.95 0.99 0.001 0.5 2"/>

  </equality>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="40" ctrlrange="-1 1"/>
    <motor name="elbow_motor" joint="elbow" gear="30" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
