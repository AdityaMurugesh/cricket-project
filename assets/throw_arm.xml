<mujoco model="throw_arm">
  <compiler angle="degree"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.3" armature="0.01"/>
    <geom contype="1" conaffinity="1" friction="0.9 0.005 0.0001"/>
  </default>

  <worldbody>
    <light diffuse="0.6 0.6 0.6" pos="0 0 4" dir="0 0 -1"/>
    <light diffuse="0.3 0.3 0.3" pos="3 -3 3" dir="-1 1 -1"/>

    <geom name="ground" type="plane" size="20 5 0.1" rgba="0.3 0.5 0.3 1"/>

    <!-- target landing zone marker, visual only -->
    <geom name="target_zone" type="box" pos="7.0 0 0.002" size="1.0 0.6 0.002"
          rgba="0.9 0.2 0.2 0.4" contype="0" conaffinity="0"/>

    <body name="shoulder_mount" pos="0 0 1.2">
      <geom type="sphere" size="0.05" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
      <body name="upper_arm" pos="0 0 0">
        <!-- lower bound tightened from 60 to 95 (start pose is 100, see
             throw_env.py): with the old 60-380 range, a random/exploring
             policy could trivially droop the arm down to the low joint
             limit and build release speed almost entirely from an elbow
             flick -- a gravity-assisted local optimum that never swings
             the shoulder through a horizontal reference at all, so it's
             fundamentally unable to satisfy ICC legality (elbow extension
             requires an arm-horizontal instant). Reward shaping alone
             (see throw_env_gym.py's swing_weight potential) wasn't enough
             to out-compete that easy escape after 2.4M validated training
             steps -- closing it off here is more reliable than continuing
             to fight it with shaping. -->
        <joint name="shoulder" type="hinge" axis="0 1 0" range="95 380" pos="0 0 0"/>
        <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.04" rgba="0.6 0.6 0.9 1"/>
        <body name="forearm" pos="0.35 0 0">
          <joint name="elbow" type="hinge" axis="0 1 0" range="0 160" pos="0 0 0"/>
          <geom type="capsule" fromto="0 0 0 0.3 0 0" size="0.035" rgba="0.5 0.5 0.8 1"/>
          <site name="hand" pos="0.3 0 0" size="0.02"/>
        </body>
      </body>
    </body>

    <body name="ball" pos="0.65 0 1.2">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.036" mass="0.16" rgba="0.9 0.9 0.9 1"/>
    </body>
  </worldbody>

  <contact>
    <!-- The ball sphere (r=0.036) sits exactly on the hand site, which is
         the endpoint of the forearm capsule (r=0.035), so the two geoms
         start 0.071 m interpenetrated and stay that way for the whole
         carry. The weld holds them together while the contact solver
         shoves them apart, and the accumulated contact force is released
         in one kick the instant the weld deactivates. That is why throws
         drifted up to 1.5 m off-line in a mechanism that is purely planar
         (the shoulder and elbow are both hinges about Y, so a correct
         release has exactly zero lateral velocity). It also injects energy
         into the release speed, which is the reported research metric.
         Excluding the pair leaves the weld as the only thing coupling the
         ball to the hand, which is what "ball welded to the end effector"
         was supposed to mean. -->
    <exclude body1="ball" body2="forearm"/>
  </contact>
  <equality>
    <!-- relpose/anchor omitted on purpose: mujoco derives them from the
         compiled qpos0 configuration, where the ball sphere is coincident
         with the hand site. This is the "ball welded to end effector". -->
    <weld name="grip" body1="ball" body2="forearm" solref="0.002 1" solimp="0.95 0.99 0.001 0.5 2"/>
  </equality>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="40" ctrlrange="-1 1"/>
    <motor name="elbow_motor" joint="elbow" gear="30" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
